# Copy this file to .env and fill in real values.

# --- LLM provider (chat/generation AND embeddings) ---
# Default: leave LLM_API_KEY / LLM_BASE_URL unset to use OpenAI directly for
# everything, with just OPENAI_API_KEY below.
#
# To route BOTH chat and embeddings through OpenRouter, set:
#   LLM_API_KEY=sk-or-v1-...                      <- your OpenRouter key
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-oss-20b                   <- OpenRouter chat model slug
#   EMBEDDING_MODEL=openai/text-embedding-3-small  <- OpenRouter embedding model slug
# embedding_api_key/embedding_base_url default to LLM_API_KEY/LLM_BASE_URL
# above, so you don't need to repeat them -- only set EMBEDDING_API_KEY /
# EMBEDDING_BASE_URL below if embeddings should use a DIFFERENT provider
# than chat.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
# Set to false if your chosen model/provider doesn't reliably honor
# response_format={"type": "json_object"} (some OpenRouter models don't).
# The client will still ask for JSON-only output via the prompt either way,
# and Pydantic validation remains the real safety net.
LLM_USE_JSON_MODE=true

# Only needed if embeddings should use a different provider/key than chat above.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Fallback default for both LLM_API_KEY and EMBEDDING_API_KEY if those are unset.
OPENAI_API_KEY=sk-your-openai-key-here

# --- Embeddings / vector store ---
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=.chroma

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.28
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Agent control-flow bounds ---
MAX_RETRIEVAL_RETRIES=1
MAX_VALIDATION_REPAIRS=1
MIN_SOURCES_REQUIRED=1

# --- Misc ---
# Set to true to run without any real API calls (tests / offline demo).
# Uses a deterministic local hashing "embedding" and requires a MockLLMClient
# wired in code -- the live API/CLI will not produce real answers in this mode.
USE_MOCK_LLM=false
LOG_LEVEL=INFO
